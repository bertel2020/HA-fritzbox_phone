{
  "entity": {
    "sensor": {
      "call_list": {
        "default": "mdi:phone-log"
      },
      "missed_calls": {
        "default": "mdi:phone-missed"
      },
      "call_monitor": {
        "default": "mdi:phone",
        "state": {
          "idle": "mdi:phone-hangup",
          "ringing": "mdi:phone-ring",
          "dialing": "mdi:phone-outgoing",
          "talking": "mdi:phone-in-talk"
        }
      },
      "phonebook": {
        "default": "mdi:contacts"
      },
      "answering_machine": {
        "default": "mdi:voicemail"
      },
      "calls_today": {
        "default": "mdi:phone-log"
      },
      "talk_time_today": {
        "default": "mdi:timer-outline"
      },
      "phoneblock_status": {
        "default": "mdi:shield-check",
        "state": {
          "ok": "mdi:shield-check",
          "error": "mdi:shield-alert",
          "unknown": "mdi:shield-outline"
        }
      },
      "reverse_lookup_status": {
        "default": "mdi:magnify",
        "state": {
          "ok": "mdi:magnify",
          "error": "mdi:magnify-close",
          "unknown": "mdi:magnify"
        }
      }
    },
    "switch": {
      "tam_enabled": {
        "default": "mdi:voicemail",
        "state": {
          "off": "mdi:voicemail"
        }
      }
    },
    "binary_sensor": {
      "ringing": {
        "default": "mdi:phone-hangup",
        "state": {
          "on": "mdi:phone-ring"
        }
      },
      "unread_messages": {
        "default": "mdi:voicemail"
      }
    },
    "event": {
      "call": {
        "default": "mdi:phone-log"
      }
    }
  },
  "services": {
    "mark_message_read": {
      "service": "mdi:email-open"
    },
    "delete_message": {
      "service": "mdi:delete"
    },
    "download_message": {
      "service": "mdi:download"
    },
    "dial": {
      "service": "mdi:phone-outgoing"
    },
    "hangup": {
      "service": "mdi:phone-hangup"
    },
    "lookup_number": {
      "service": "mdi:magnify"
    },
    "block_number": {
      "service": "mdi:phone-cancel"
    },
    "unblock_number": {
      "service": "mdi:phone-check"
    }
  }
}
